{
  "name": "@contextcompany/claude",
  "version": "2.0.0",
  "description": "The Context Company integration for Claude Agent SDK",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "pnpm build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "keywords": [
    "claude",
    "anthropic",
    "agent",
    "observability",
    "tracing",
    "monitoring",
    "context-company"
  ],
  "homepage": "https://docs.thecontextcompany.com/frameworks/claude-agent-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Context-Company/observatory",
    "directory": "packages/ts/claude"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.273 <0.4"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.273",
    "@anthropic-ai/sdk": "^0.93.0",
    "@contextcompany/api": "workspace:*",
    "@types/node": "^20",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "zod": "^4.5.4"
  }
}
